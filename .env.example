# ==========================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. Project Automation & AI Gemini
# ------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# GitHub Personal Access Token (classic token with 'repo' scope)
# (Get at: https://github.com/settings/tokens)
GITHUB_READ_USER_TOKEN_PERSONAL=your_github_personal_token
GITHUB_USERNAME=saecar
PORTFOLIO_REPO=saecar/SaecarPortfolio

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ⚠️ CRITICAL SECURITY: NEVER expose to client / NEVER prefix with NEXT_PUBLIC_. Server-only!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vercel Deployment (Optional, from https://vercel.com/account/tokens)
VERCEL_TOKEN=your_vercel_token

# Webhook / Cron Sync Secret (Optional, for zero-touch GitHub webhook)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
SYNC_SECRET=your_sync_secret

# ------------------------------------------
# 2. General / Site Info & Admin Allowlist
# ------------------------------------------
DOMAIN=https://satriabahari.my.id
NEXT_PUBLIC_AUTHOR_EMAIL=maybedills@gmail.com
# Comma-separated list of admin emails authorized for /admin portal
ADMIN_EMAILS=maybedills@gmail.com,satriaaxel7703@gmail.com

# ------------------------------------------
# 3. NextAuth & Authentication
# ------------------------------------------
NEXTAUTH_URL=https://satriabahari.my.id
# Must be at least 32 characters in production (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App
GITHUB_ID=your_github_app_id
GITHUB_SECRET=your_github_app_secret

# ------------------------------------------
# 4. Email (Nodemailer)
# ------------------------------------------
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PW=your_email_app_password

# ------------------------------------------
# 5. Database (PostgreSQL / Supabase direct)
# ------------------------------------------
POSTGRES_URL=your_postgres_url
POSTGRES_PRISMA_URL=your_prisma_url
POSTGRES_URL_NO_SSL=your_postgres_url_no_ssl
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_db

# ------------------------------------------
# 6. Analytics & External Stats
# ------------------------------------------
# Umami Analytics (Cloud: https://cloud.umami.is)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id_for_tracking
UMAMI_API_KEY=your_umami_api_key
UMAMI_WEBSITE_ID_MYID=your_umami_website_id_for_dashboard_stats
UMAMI_WEBSITE_ID_SITE=your_site_id

# Wakatime Stats (https://wakatime.com/settings/api-key)
NEXT_PUBLIC_WAKATIME_USERNAME=your_wakatime_username
WAKATIME_API_KEY=your_wakatime_secret_api_key
WAKATIME_API_ID=your_wakatime_id

MONKEYTYPE_API_KEY=your_monkeytype_api_key
CODEWARS_USER_ID=your_codewars_username
